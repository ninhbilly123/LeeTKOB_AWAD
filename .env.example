# ========================================================
# LeeTKOB Environment Variables Template
# Copy this file to .env and fill in the values
# DO NOT COMMIT REAL CREDENTIALS TO GIT HISTORY
# ========================================================

# Gateway Service
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_NAME=leetkob_db

# Redis (Rate limit & Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (Queue)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Storage (Garage S3 compatible)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_TESTS=leetkob-tests
S3_BUCKET_SUBMISSIONS=leetkob-submissions

# Constraint Checker (Python & LLM)
# Model API Key has spending cap = $10 USD
GEMINI_API_KEY=your_gemini_api_key_here
CHECKER_PORT=8001
MONGODB_URI=mongodb://localhost:27017/leetkob_checker

