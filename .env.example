# ========================================================
# LeeTKOB Environment Variables Template
# Copy this file to .env and fill in the values
# DO NOT COMMIT REAL CREDENTIALS TO GIT HISTORY
# ========================================================

# Gateway Service
PORT=
NODE_ENV=
# Comma-separated allowed web origins for CORS in production (e.g., https://leetkob.vercel.app)
CORS_ORIGINS=
# Required to start Gateway: private random HS256 secret, at least 32 bytes.
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=
# Defaults to 'postgres' outside tests; set 'memory' only for non-production local prototyping.
PERSISTENCE_MODE=
# Set to 'true' only when intentionally running db:seed:demo in PA#3 demo environments.
ALLOW_DEMO_SEED=

# Database (PostgreSQL 16)
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DB_POOL_MAX=

# Redis (Rate limit & Pub/Sub)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# RabbitMQ (Queue)
RABBITMQ_URL=

# Storage (Garage S3 compatible)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_TESTS=
S3_BUCKET_SUBMISSIONS=

# Constraint Checker (Python & LLM — ONLY container holding GEMINI_API_KEY)
# Current team plan: Gemini API free tier; offline tests make no real model calls.
# Reassess quotas and spending controls before any future move to paid usage.
GEMINI_API_KEY=
GEMINI_MODEL=
MODEL_OFF=
CHECKER_PORT=

# Judge Worker (Standalone Queue Consumer — NEVER pass GEMINI_API_KEY here)
SANDBOX_MODE=
SANDBOX_IMAGE=
DOCKER_HOST=
CHECKER_URL=
CHECKER_TIMEOUT_MS=
WORKER_POLL_INTERVAL_MS=
STALE_JOB_AFTER_SEC=
MAX_LLM_CALLS_PER_LAB=
# Frontend (Web — React + Vite; never store secrets in VITE_* variables)
WEB_PORT=
VITE_API_MODE=
VITE_API_BASE_URL=
VITE_GATEWAY_PROXY_TARGET=
VITE_SHOW_DEMO_ACCOUNTS=
