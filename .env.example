# ========================================================
# LeeTKOB Environment Variables Template
# Copy this file to .env and fill in the values
# DO NOT COMMIT REAL CREDENTIALS TO GIT HISTORY
# ========================================================

# Gateway Service
PORT=
NODE_ENV=
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Database (PostgreSQL)
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Redis (Rate limit & Pub/Sub)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# RabbitMQ (Queue)
RABBITMQ_URL=

# Storage (Garage S3 compatible)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_TESTS=
S3_BUCKET_SUBMISSIONS=

# Constraint Checker (Python & LLM)
# Model API Key has spending cap = $10 USD
GEMINI_API_KEY=
CHECKER_PORT=
MONGODB_URI=
